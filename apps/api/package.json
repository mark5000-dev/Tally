{
  "name": "@tally/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "bun dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check src drizzle.config.ts",
    "test": "tsx --test src/features/auth/schema.test.ts src/features/polls/schema.test.ts src/features/polls/policy.test.ts src/features/billing/pricing.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "bun src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "admin:promote": "bun src/db/promote-admin.ts"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.44.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "nodemailer": "^7.0.10",
    "postgres": "^3.4.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@types/cors": "^2.8.19",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/nodemailer": "^6.4.17",
    "@types/node": "^22.19.0",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
