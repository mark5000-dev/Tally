DATABASE_URL=postgres://tally:tally_local_only@localhost:5432/tally
# Optional. drizzle-kit migrates over this URL instead of DATABASE_URL, which is
# how Neon's unpooled endpoint gets used for migrations while the API keeps
# talking to the pooled one.
# DATABASE_URL_UNPOOLED=
API_PORT=4001
# Render, Railway, and Fly assign the listen port themselves and pass it as
# PORT; it takes precedence over API_PORT when set.
# PORT=
# Comma-separated browser origins allowed to call the API. A "*" matches one
# hostname label, so "https://*.vercel.app" covers per-branch preview
# deployments. The first entry without a "*" is the one account emails link to.
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4001/api/v1
# lax | none | strict. Defaults to "none" when NODE_ENV=production (the web app
# and the API sit on unrelated domains, so browsers treat calls as cross-site
# and withhold a lax cookie), and "lax" otherwise. Set "lax" explicitly once
# both services share a registrable domain.
# COOKIE_SAME_SITE=lax
# Whether Express may read X-Forwarded-For. Defaults to trusting one proxy hop
# when NODE_ENV=production, which is what a managed host puts in front of the
# process, and to trusting nothing otherwise.
# TRUST_PROXY=true
FEATURED_POLL_CHARGE_MINOR=10000
ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
