{
  "name": "tally-platform",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --parallel dev:web dev:api",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:api": "bun run --env-file=../../.env --cwd apps/api dev",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "bun run --cwd apps/web lint && bun run --cwd apps/api lint",
    "db:generate": "bun run --env-file=../../.env --cwd apps/api db:generate",
    "db:migrate": "bun run --env-file=../../.env --cwd apps/api db:migrate",
    "db:seed": "bun run --env-file=../../.env --cwd apps/api db:seed",
    "db:studio": "bun run --env-file=../../.env --cwd apps/api db:studio",
    "db:push": "bun run --env-file=../../.env --cwd apps/api db:push",
    "admin:promote": "bun run --env-file=../../.env --cwd apps/api admin:promote"
  }
}
